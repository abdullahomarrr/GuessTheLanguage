# Optional Gemini intent router for informally worded clue questions.
GEMINI_API_KEY=
GEMINI_CLUE_MODEL=gemini-3.1-flash-lite

# Admin authentication. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Analytics persistence and pseudonymous visitor hashing.
DATABASE_URL=
ANALYTICS_HASH_SECRET=

# Optional public override; defaults to /admin/api/ingest.
NEXT_PUBLIC_LINGO_ANALYTICS_ENDPOINT=
